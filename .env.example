# Firebase Web Config
# Get these from Firebase Console > Project Settings > Web App
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional: Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Analytics (gtag.js) — Measurement ID from analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# WhatsApp click-to-chat support button — business number in international
# format, no '+' or spaces, e.g. 919876543210. Button is hidden if unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Razorpay (for Week 2)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
