# JavihAI Landing Page — Environment Variables
# Copy this file to .env.local and fill in real values
# cp .env.local.example .env.local

# ── Firebase Web Client (public — safe to expose) ────────────────────────────
# Get from: console.firebase.google.com → ai-interview-tutor → Project Settings → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ai-interview-tutor.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ai-interview-tutor
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ai-interview-tutor.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# ── Firebase Admin SDK (server-side only — NEVER commit to git) ──────────────
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the entire JSON on ONE line (remove all newlines)
FIREBASE_ADMIN_SDK_JSON={"type":"service_account","project_id":"ai-interview-tutor","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@ai-interview-tutor.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ── Groq API (server-side only) ──────────────────────────────────────────────
# Get from: console.groq.com → API Keys
GROQ_API_KEY=gsk_...

# ── Razorpay (use rzp_test_ prefix for test mode, rzp_live_ for production) ──
# Get from: dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...

# ── Resend Email ──────────────────────────────────────────────────────────────
# Get from: resend.com → API Keys
# Also verify javihai.in domain in Resend → Domains
RESEND_API_KEY=re_...

# ── Adzuna Jobs API ───────────────────────────────────────────────────────────
# Get from: developer.adzuna.com → My Apps
ADZUNA_APP_ID=7f703165
ADZUNA_APP_KEY=...

# ── GitHub (private ai-interview-helper repo — for /install download proxy) ──
# Get from: github.com → Settings → Developer settings → Personal access tokens
# Fine-grained token scoped to smartjaganrao/ai-interview-helper with
# repository permission "Contents: Read-only" is enough.
GITHUB_TOKEN=github_pat_...

# ── CRON Security Token ───────────────────────────────────────────────────────
# Random secret to protect /api/email/schedule from unauthorized calls
# Generate: openssl rand -hex 16
CRON_SECRET=...

# ── Google Analytics 4 ───────────────────────────────────────────────────────
# Get from: analytics.google.com → Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-KSDLBYG165

# ── Twilio WhatsApp (server-side only) ────────────────────────────────────────
# TWILIO_ACCOUNT_SID (starts "AC...") is always required — from
# console.twilio.com → Account Info.
# Then EITHER:
#   TWILIO_AUTH_TOKEN                          (simplest — same Account Info page), OR
#   TWILIO_API_KEY_SID + TWILIO_API_KEY_SECRET  (API Key auth, Twilio's recommended
#                                                 production option — console.twilio.com
#                                                 → Account → API keys & tokens.
#                                                 Note: the key SID/secret alone can't
#                                                 authenticate — Account SID is still needed.)
# TWILIO_WHATSAPP_FROM: console.twilio.com → Messaging → Senders → WhatsApp senders
# (production number, requires Meta Business verification — see twilio-whatsapp-manage-senders).
# TWILIO_TEMPLATE_WELCOME_SID is a Meta-approved Content Template SID (HX...)
# from Messaging → Content Template Builder — required because the welcome
# message is business-initiated (outside any 24hr session window), so a
# free-form message would silently fail to deliver.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# TWILIO_API_KEY_SID=SK...
# TWILIO_API_KEY_SECRET=...
TWILIO_WHATSAPP_FROM=+1415...
TWILIO_TEMPLATE_WELCOME_SID=HX...

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://javihai.in
